{
  "title": "Wind Compass — Demo",
  "description": "Self-contained showcase of the Clean, Marine and Instrument skins using sample data (makeresults). Works on any Splunk instance — no index required.",
  "visualizations": {
    "viz_clean": {
      "type": "windcompass.windcompass",
      "title": "Clean — Berlin",
      "dataSources": { "primary": "ds_berlin" },
      "options": {
        "windcompass.windcompass.skin": "clean",
        "windcompass.windcompass.showTemperature": true,
        "windcompass.windcompass.showLocation": true,
        "windcompass.windcompass.fieldWindDirection": "wind_direction_10m",
        "windcompass.windcompass.fieldWindSpeed": "wind_speed_10m",
        "windcompass.windcompass.fieldLocation": "city",
        "windcompass.windcompass.fieldCountry": "country",
        "windcompass.windcompass.fieldTemperature": "temperature_2m"
      }
    },
    "viz_marine": {
      "type": "windcompass.windcompass",
      "title": "Marine — Vilnius",
      "dataSources": { "primary": "ds_vilnius" },
      "options": {
        "windcompass.windcompass.skin": "marine",
        "windcompass.windcompass.showTemperature": true,
        "windcompass.windcompass.showLocation": true,
        "windcompass.windcompass.fieldWindDirection": "wind_direction_10m",
        "windcompass.windcompass.fieldWindSpeed": "wind_speed_10m",
        "windcompass.windcompass.fieldLocation": "city",
        "windcompass.windcompass.fieldCountry": "country",
        "windcompass.windcompass.fieldTemperature": "temperature_2m"
      }
    },
    "viz_instrument": {
      "type": "windcompass.windcompass",
      "title": "Instrument — San Francisco",
      "dataSources": { "primary": "ds_sanfrancisco" },
      "options": {
        "windcompass.windcompass.skin": "instrument",
        "windcompass.windcompass.trueNeedleType": "instrument",
        "windcompass.windcompass.showCenterSpeed": true,
        "windcompass.windcompass.showTemperature": true,
        "windcompass.windcompass.showLocation": true,
        "windcompass.windcompass.fieldWindDirection": "wind_direction_10m",
        "windcompass.windcompass.fieldWindSpeed": "wind_speed_10m",
        "windcompass.windcompass.fieldLocation": "city",
        "windcompass.windcompass.fieldCountry": "country",
        "windcompass.windcompass.fieldTemperature": "temperature_2m"
      }
    }
  },
  "dataSources": {
    "ds_berlin": {
      "type": "ds.search",
      "name": "Berlin sample",
      "options": {
        "query": "| makeresults\n| eval city=\"Berlin\", country=\"Germany\", wind_direction_10m=225, wind_speed_10m=18.5, temperature_2m=12.0\n| fields city country wind_direction_10m wind_speed_10m temperature_2m"
      }
    },
    "ds_vilnius": {
      "type": "ds.search",
      "name": "Vilnius sample",
      "options": {
        "query": "| makeresults\n| eval city=\"Vilnius\", country=\"Lithuania\", wind_direction_10m=315, wind_speed_10m=11.2, temperature_2m=8.5\n| fields city country wind_direction_10m wind_speed_10m temperature_2m"
      }
    },
    "ds_sanfrancisco": {
      "type": "ds.search",
      "name": "San Francisco sample",
      "options": {
        "query": "| makeresults\n| eval city=\"San Francisco\", country=\"United States\", wind_direction_10m=270, wind_speed_10m=22.0, temperature_2m=16.5\n| fields city country wind_direction_10m wind_speed_10m temperature_2m"
      }
    }
  },
  "inputs": {},
  "layout": {
    "type": "absolute",
    "options": {
      "width": 1320,
      "height": 560,
      "backgroundColor": "#12141a"
    },
    "globalInputs": [],
    "structure": [
      { "item": "viz_clean",      "type": "block", "position": { "x": 15,  "y": 20, "w": 420, "h": 520 } },
      { "item": "viz_marine",     "type": "block", "position": { "x": 450, "y": 20, "w": 420, "h": 520 } },
      { "item": "viz_instrument", "type": "block", "position": { "x": 885, "y": 20, "w": 420, "h": 520 } }
    ]
  }
}
