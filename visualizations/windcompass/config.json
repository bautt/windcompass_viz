                "layout": [
                    [
                        {
                            "editor": "editor.select",
                            "label": "Needle type",
                            "option": "apparentNeedleType",
                            "editorProps": {
                                "values": [
                                    { "label": "Classic", "value": "classic" },
                                    { "label": "Slim", "value": "slim" },
                                    { "label": "Barbed", "value": "barbed" },
                                    { "label": "Diamond", "value": "diamond" },
                                    { "label": "Feather", "value": "feather" },
                                    { "label": "Dot + line", "value": "dot_line" },
                                    { "label": "Instrument", "value": "instrument" }
                                ]
                            }
                        }
                    ],
                    [
                        {
                            "editor": "editor.color",
                            "label": "Needle color",
                            "option": "apparentNeedleColor"
                        }
                    ],
                    [
                        {
                            "editor": "editor.color",
                            "label": "Tail color",
                            "option": "apparentTailColor"
                        }
                    ],
                    [
                        {
                            "editor": "editor.checkbox",
