{
    "showTitleAndDescription": true,
    "includeInToolbar": true,
    "includeInVizSwitcher": true,
    "showDrilldown": false,
    "config": {
        "name": "Wind Compass",
        "description": "Animated wind compass. Live mode: just set a City — no search required, data from Open-Meteo. Search mode: bind your own search with wind_direction (0–360°) and wind_speed fields.",
        "category": "Custom",
        "dataContract": {
            "requiredDataSources": ["primary"]
        },
        "size": {
            "initialWidth": 400,
            "initialHeight": 420
        },
        "optionsSchema": {
            "dataMode": {
                "type": "string",
                "default": "live",
                "enum": ["live", "search"]
            },
            "city": { "type": "string", "default": "Berlin" },
            "country": { "type": "string", "default": "" },
            "refreshSec": { "type": "number", "default": 300 },
            "skin": {
                "type": "string",
                "default": "clean",
                "enum": ["clean", "marine", "instrument"]
            },
            "themeOverride": {
                "type": "string",
                "default": "auto",
                "enum": ["auto", "light", "dark"]
            },
            "trueNeedleType": {
                "type": "string",
                "default": "",
                "enum": ["", "clean", "classic", "slim", "barbed", "diamond", "feather", "dot_line", "instrument"]
            },
            "speedUnit": {
                "type": "string",
                "default": "kmh",
                "enum": ["kmh", "ms", "knots", "mph"]
            },
            "tempUnit": {
                "type": "string",
                "default": "c",
                "enum": ["c", "f"]
            },
            "backgroundColor": { "type": "string", "default": "" },
            "showFrame": { "type": "boolean", "default": false },
            "frameColor": { "type": "string", "default": "" },
            "bezelColor": { "type": "string", "default": "" },
            "dialColor": { "type": "string", "default": "" },
            "textColor": { "type": "string", "default": "" },
            "tickColor": { "type": "string", "default": "" },
            "tickMajorColor": { "type": "string", "default": "" },
            "hubColor": { "type": "string", "default": "" },
            "trueNeedleColor": { "type": "string", "default": "" },
            "trueTailColor": { "type": "string", "default": "" },
            "showCardinals": { "type": "boolean", "default": true },
            "showMajorTicks": { "type": "boolean", "default": true },
            "showMinorTicks": { "type": "boolean", "default": true },
            "showTrueWind": { "type": "boolean", "default": true },
            "showTrueDirectionReadout": { "type": "boolean", "default": true },
            "showTrueSpeedReadout": { "type": "boolean", "default": true },
            "showCenterSpeed": { "type": "boolean", "default": false },
            "showTemperature": { "type": "boolean", "default": false },
            "showLocation": { "type": "boolean", "default": true },
            "showDirectionLabel": { "type": "boolean", "default": true },
            "showWeatherCondition": { "type": "boolean", "default": true },
            "showCompass": { "type": "boolean", "default": true },
            "animationDurationMs": { "type": "number", "default": 600 },
            "readoutPosition": {
                "type": "string",
                "default": "bottom",
                "enum": ["bottom", "top"]
            },
            "fieldWindDirection": { "type": "string", "default": "wind_direction" },
            "fieldWindSpeed": { "type": "string", "default": "wind_speed" },
            "fieldLocation": { "type": "string", "default": "location" },
            "fieldTemperature": { "type": "string", "default": "temperature" },
            "fieldWindGusts": { "type": "string", "default": "wind_gusts" },
            "fieldCountry": { "type": "string", "default": "country" },
            "fieldWeatherCode": { "type": "string", "default": "weather_code" },
            "fieldIsDay": { "type": "string", "default": "is_day" }
        },
        "editorConfig": [
            {
                "label": "Data source",
                "layout": [
                    [
                        {
                            "editor": "editor.select",
                            "label": "Mode",
                            "option": "dataMode",
                            "editorProps": {
                                "values": [
                                    { "label": "Live (Open-Meteo, no search needed)", "value": "live" },
                                    { "label": "Search (use your own data)", "value": "search" }
                                ]
                            }
                        }
                    ],
                    [
                        {
                            "editor": "editor.text",
                            "label": "Live: City",
                            "option": "city"
                        }
                    ],
                    [
                        {
                            "editor": "editor.text",
                            "label": "Live: Country (optional — e.g. DE or Germany)",
                            "option": "country"
                        }
                    ],
                    [
                        {
                            "editor": "editor.number",
                            "label": "Live: refresh interval (seconds, min 60)",
                            "option": "refreshSec"
                        }
                    ]
                ]
            },
            {
                "label": "Style",
                "layout": [
                    [
                        {
                            "editor": "editor.checkbox",
                            "label": "Compass dial (off = weather-only)",
                            "option": "showCompass"
                        }
                    ],
                    [
                        {
                            "editor": "editor.select",
                            "label": "Skin",
                            "option": "skin",
                            "editorProps": {
                                "values": [
                                    { "label": "Clean", "value": "clean" },
                                    { "label": "Marine", "value": "marine" },
                                    { "label": "Instrument", "value": "instrument" }
                                ]
                            }
                        }
                    ],
                    [
                        {
                            "editor": "editor.select",
                            "label": "Theme",
                            "option": "themeOverride",
                            "editorProps": {
                                "values": [
                                    { "label": "Auto (follow dashboard)", "value": "auto" },
                                    { "label": "Light", "value": "light" },
                                    { "label": "Dark", "value": "dark" }
                                ]
                            }
                        }
                    ],
                    [
                        {
                            "editor": "editor.checkbox",
                            "label": "Cardinal labels",
                            "option": "showCardinals"
                        }
                    ],
                    [
                        {
                            "editor": "editor.checkbox",
                            "label": "Major ticks",
                            "option": "showMajorTicks"
                        }
                    ],
                    [
                        {
                            "editor": "editor.checkbox",
                            "label": "Minor ticks",
                            "option": "showMinorTicks"
                        }
                    ],
                    [
                        {
                            "editor": "editor.number",
                            "label": "Animation (ms)",
                            "option": "animationDurationMs"
                        }
                    ]
                ]
            },
            {
                "label": "Colors",
                "layout": [
                    [
                        {
                            "editor": "editor.color",
                            "label": "Background",
                            "option": "backgroundColor"
                        }
                    ],
                    [
                        {
                            "editor": "editor.checkbox",
                            "label": "Rounded frame",
                            "option": "showFrame"
                        }
                    ],
                    [
                        {
                            "editor": "editor.color",
                            "label": "Frame",
                            "option": "frameColor"
                        }
                    ],
                    [
                        {
                            "editor": "editor.color",
                            "label": "Bezel",
                            "option": "bezelColor"
                        }
                    ],
                    [
                        {
                            "editor": "editor.color",
                            "label": "Dial face",
                            "option": "dialColor"
                        }
                    ],
                    [
                        {
                            "editor": "editor.color",
                            "label": "Text",
                            "option": "textColor"
                        }
                    ],
                    [
                        {
                            "editor": "editor.color",
                            "label": "Minor ticks",
                            "option": "tickColor"
                        }
                    ],
                    [
                        {
                            "editor": "editor.color",
                            "label": "Major ticks",
                            "option": "tickMajorColor"
                        }
                    ],
                    [
                        {
                            "editor": "editor.color",
                            "label": "Center hub",
                            "option": "hubColor"
                        }
                    ]
                ]
            },
            {
                "label": "True wind",
                "layout": [
                    [
                        {
                            "editor": "editor.select",
                            "label": "Needle type",
                            "option": "trueNeedleType",
                            "editorProps": {
                                "values": [
                                    { "label": "Auto (match skin)", "value": "" },
                                    { "label": "Clean", "value": "clean" },
                                    { "label": "Classic", "value": "classic" },
                                    { "label": "Slim", "value": "slim" },
                                    { "label": "Barbed", "value": "barbed" },
                                    { "label": "Diamond", "value": "diamond" },
                                    { "label": "Feather", "value": "feather" },
                                    { "label": "Dot + line", "value": "dot_line" },
                                    { "label": "Instrument", "value": "instrument" }
                                ]
                            }
                        }
                    ],
                    [
                        {
                            "editor": "editor.color",
                            "label": "Needle color",
                            "option": "trueNeedleColor"
                        }
                    ],
                    [
                        {
                            "editor": "editor.color",
                            "label": "Tail color",
                            "option": "trueTailColor"
                        }
                    ],
                    [
                        {
                            "editor": "editor.checkbox",
                            "label": "Show true-wind needle",
                            "option": "showTrueWind"
                        }
                    ],
                    [
                        {
                            "editor": "editor.checkbox",
                            "label": "Direction readout",
                            "option": "showTrueDirectionReadout"
                        }
                    ],
                    [
                        {
                            "editor": "editor.checkbox",
                            "label": "Speed readout",
                            "option": "showTrueSpeedReadout"
                        }
                    ],
                    [
                        {
                            "editor": "editor.checkbox",
                            "label": "Speed in center hub",
                            "option": "showCenterSpeed"
                        }
                    ]
                ]
            },
            {
                "label": "Readouts",
                "layout": [
                    [
                        {
                            "editor": "editor.checkbox",
                            "label": "Location",
                            "option": "showLocation"
                        }
                    ],
                    [
                        {
                            "editor": "editor.checkbox",
                            "label": "Temperature",
                            "option": "showTemperature"
                        }
                    ],
                    [
                        {
                            "editor": "editor.checkbox",
                            "label": "Weather icon (sun/rain/snow/…)",
                            "option": "showWeatherCondition"
                        }
                    ],
                    [
                        {
                            "editor": "editor.checkbox",
                            "label": "Compass label (N, NNW, …)",
                            "option": "showDirectionLabel"
                        }
                    ],
                    [
                        {
                            "editor": "editor.select",
                            "label": "Speed unit",
                            "option": "speedUnit",
                            "editorProps": {
                                "values": [
                                    { "label": "km/h", "value": "kmh" },
                                    { "label": "m/s", "value": "ms" },
                                    { "label": "Knots", "value": "knots" },
                                    { "label": "mph", "value": "mph" }
                                ]
                            }
                        }
                    ],
                    [
                        {
                            "editor": "editor.select",
                            "label": "Temperature unit",
                            "option": "tempUnit",
                            "editorProps": {
                                "values": [
                                    { "label": "Celsius", "value": "c" },
                                    { "label": "Fahrenheit", "value": "f" }
                                ]
                            }
                        }
                    ],
                    [
                        {
                            "editor": "editor.select",
                            "label": "Readout position",
                            "option": "readoutPosition",
                            "editorProps": {
                                "values": [
                                    { "label": "Below dial", "value": "bottom" },
                                    { "label": "Above dial", "value": "top" }
                                ]
                            }
                        }
                    ]
                ]
            },
            {
                "label": "Search: field mapping",
                "layout": [
                    [
                        {
                            "editor": "editor.text",
                            "label": "Wind direction (required)",
                            "option": "fieldWindDirection"
                        }
                    ],
                    [
                        {
                            "editor": "editor.text",
                            "label": "Wind speed (required, km/h)",
                            "option": "fieldWindSpeed"
                        }
                    ],
                    [
                        {
                            "editor": "editor.text",
                            "label": "Location",
                            "option": "fieldLocation"
                        }
                    ],
                    [
                        {
                            "editor": "editor.text",
                            "label": "Country",
                            "option": "fieldCountry"
                        }
                    ],
                    [
                        {
                            "editor": "editor.text",
                            "label": "Temperature (°C)",
                            "option": "fieldTemperature"
                        }
                    ],
                    [
                        {
                            "editor": "editor.text",
                            "label": "Wind gusts (km/h, weather-only layout)",
                            "option": "fieldWindGusts"
                        }
                    ],
                    [
                        {
                            "editor": "editor.text",
                            "label": "Weather code (WMO, optional)",
                            "option": "fieldWeatherCode"
                        }
                    ],
                    [
                        {
                            "editor": "editor.text",
                            "label": "Is day (0/1, optional)",
                            "option": "fieldIsDay"
                        }
                    ]
                ]
            }
        ]
    }
}
